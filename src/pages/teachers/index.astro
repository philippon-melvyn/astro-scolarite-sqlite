---
import Layout from "../../layouts/Layout.astro";
import db from "../../lib/db";

const rows = db
  .prepare("SELECT id, first_name, last_name, email FROM teachers ORDER BY last_name")
  .all();
---

<Layout title="Teachers">
  <h1>Teachers</h1>

  <table>
    <thead>
      <tr>
        <th>ID</th>
        <th>Prénom</th>
        <th>Nom</th>
        <th>Email</th>
      </tr>
    </thead>

    <tbody>
      {
        rows.map((teacher) => (
          <tr>
            <td>{teacher.id}</td>
            <td>{teacher.first_name}</td>
            <td>{teacher.last_name}</td>
            <td>{teacher.email}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</Layout>